# Copy to web/.env.local (or .env.development.local for development only). Never commit the real file.
# API base URL: the Cloud Run service, or http://localhost:8080 for the local API.
VITE_API_URL=https://tap-twice-api-973641804480.asia-southeast2.run.app
# Firebase web config (public by design). Get it with: firebase apps:sdkconfig WEB --project tap-twice-aurania
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tap-twice-aurania.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tap-twice-aurania
VITE_FIREBASE_APP_ID=
# Which AI the app uses: "mock" (default, offline, deterministic) or "gemini" (through the API).
VITE_AI_PROVIDER=mock
